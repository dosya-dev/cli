{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    // The binary is produced by `bun build --compile`; tsc only typechecks.
    // A rootDir here would reject the cross-package @dosya-dev/shared import.
    "noEmit": true,
    "paths": {
      "@dosya-dev/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src", "tests"]
}
